rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: public read, authenticated write
    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Gallery: public read, authenticated write
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Inquiries: anyone can create (submit form), only authenticated can read/update/delete
    match /inquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    // Settings: only authenticated users
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }
    // Users: authenticated users can read/write their own doc; authenticated users can read all (for admin)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Suppliers: only authenticated users (admin/staff)
    match /suppliers/{docId} {
      allow read, write: if request.auth != null;
    }
    // Purchase Orders: only authenticated users (admin/staff)
    match /purchase_orders/{docId} {
      allow read, write: if request.auth != null;
    }
    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
