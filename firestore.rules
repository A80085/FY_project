rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if requester is admin/manager via Custom Claims (zero read cost), master email, or Firestore user doc
    function isPrivilegedUser() {
      return request.auth != null &&
             (
               (request.auth.token != null && request.auth.token.role in ["admin", "manager"]) ||
               (request.auth.token.email in ["admin@mangalam.com", "admin1@mangalam.com"]) ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "manager"])
             );
    }

    // Products: public catalog read, admin/manager write only
    match /products/{docId} {
      allow read: if true;
      allow write: if isPrivilegedUser();
    }

    // Gallery: public read, admin/manager write only
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isPrivilegedUser();
    }

    // Inquiries: public submission with schema and size validation, admin/manager read/update/delete only
    match /inquiries/{docId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 120 &&
                       (!("phone" in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
                       (!("email" in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120)) &&
                       (!("message" in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2000)) &&
                       (!("status" in request.resource.data) || request.resource.data.status in ["New", "new", "Pending", "pending"]);
      allow read, update, delete: if isPrivilegedUser();
    }

    // Settings: public read for showroom details & estimate rates, admin/manager write only
    match /settings/{docId} {
      allow read: if true;
      allow write: if isPrivilegedUser();
    }

    // Users:
    // - get: single profile read allowed for own document or admin/manager (prevents customer harvesting)
    // - list: collection queries restricted to admin/manager
    // - create: user can only initialize self as customer (or designated master admin email), preventing privilege escalation
    // - update: user cannot modify own role; only admin/manager can alter roles
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isPrivilegedUser());
      allow list: if isPrivilegedUser();
      allow create: if (request.auth.uid == userId &&
                        (
                          !("role" in request.resource.data) ||
                          request.resource.data.role == "customer" ||
                          (request.auth.token.email in ["admin@mangalam.com", "admin1@mangalam.com"] && request.resource.data.role == "admin")
                        )) || isPrivilegedUser();
      allow update: if (request.auth.uid == userId &&
                        !("role" in request.resource.data.diff(resource.data).affectedKeys())) ||
                       isPrivilegedUser();
      allow delete: if isPrivilegedUser();
    }

    // Suppliers: admin/manager only
    match /suppliers/{docId} {
      allow read, write: if isPrivilegedUser();
    }

    // Purchase Orders: admin/manager only
    match /purchase_orders/{docId} {
      allow read, write: if isPrivilegedUser();
    }

    // In-Store Sales (IRL): admin/manager only
    match /sales/{docId} {
      allow read, write: if isPrivilegedUser();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
