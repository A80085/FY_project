rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if requester is admin/manager via Custom Claims (zero read cost) or Firestore user doc
    function isPrivilegedUser() {
      return request.auth != null &&
             (
               (request.auth.token != null && request.auth.token.role in ["admin", "manager"]) ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "manager"])
             );
    }

    // Products: public catalog read, admin/manager write only
    match /products/{docId} {
      allow read: if true;
      allow write: if isPrivilegedUser();
    }

    // Gallery: public read, admin/manager write only
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isPrivilegedUser();
    }

    // Inquiries: anyone can submit a form (create), only admin/manager can read/update/delete
    match /inquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isPrivilegedUser();
    }

    // Settings: public read for showroom details & estimate rates, admin/manager write only
    match /settings/{docId} {
      allow read: if true;
      allow write: if isPrivilegedUser();
    }

    // Users: authenticated users can read all profiles (needed for role management UI),
    // but can ONLY write their own document and CANNOT change their own role field.
    match /users/{userId} {
      allow read: if request.auth != null;
      // Own profile: can update anything except the role field
      allow update: if request.auth.uid == userId &&
                       !("role" in request.resource.data.diff(resource.data).affectedKeys());
      // Create own doc (on first login/register)
      allow create: if request.auth.uid == userId;
      // Only admin/manager can change roles or write other users' docs
      allow write: if isPrivilegedUser();
    }

    // Suppliers: admin/manager only
    match /suppliers/{docId} {
      allow read, write: if isPrivilegedUser();
    }

    // Purchase Orders: admin/manager only
    match /purchase_orders/{docId} {
      allow read, write: if isPrivilegedUser();
    }

    // In-Store Sales (IRL): admin/manager only
    match /sales/{docId} {
      allow read, write: if isPrivilegedUser();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
